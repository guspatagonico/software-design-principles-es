---
import '../styles/base.css';
import '../styles/layout.css';

const {
	title,
	accent,
	widthClass,
	description,
	image = 'og/index.jpg',
	canonicalURL,
	type = 'website',
	jsonLd,
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const siteURL = Astro.site;
const imageURL = image.startsWith('http') ? image : `${siteURL}/${image}`;
const ogTitle = title;
const ogDescription = description || title;
const SITE_NAME = 'Principios de Diseño de Software';
const LOCALE = 'es_ES';
---
<!DOCTYPE html>
<html lang="es" data-accent={accent ?? ''} class={widthClass ?? ''}>
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{title}</title>
	{description && <meta name="description" content={description} />}

	<!-- Canonical -->
	{canonicalURL && <link rel="canonical" href={canonicalURL} />}

	<!-- Favicon -->
	<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />

	<!-- Open Graph -->
	<meta property="og:title" content={ogTitle} />
	{ogDescription && <meta property="og:description" content={ogDescription} />}
	<meta property="og:type" content={type} />
	{canonicalURL && <meta property="og:url" content={canonicalURL} />}
	<meta property="og:image" content={imageURL} />
	<meta property="og:image:width" content="1200" />
	<meta property="og:image:height" content="630" />
	<meta property="og:site_name" content={SITE_NAME} />
	<meta property="og:locale" content={LOCALE} />

	<!-- Twitter Card -->
	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:title" content={ogTitle} />
	{ogDescription && <meta name="twitter:description" content={ogDescription} />}
	<meta name="twitter:image" content={imageURL} />

	<!-- JSON-LD Structured Data (GEO / Agent-friendly) -->
	{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>}
</head>
<body>
	<slot />
	<script is:inline src={`${base}js/tabs.js`}></script>
</body>
</html>
