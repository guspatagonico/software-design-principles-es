---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../components/SiteNav.astro';
import TabNav from '../../components/TabNav.astro';
import ProgressNav from '../../components/ProgressNav.astro';
import ContextSection from '../../components/ContextSection.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
	const principles = await getCollection('principle');
	return principles.map(entry => ({
		params: { slug: entry.data.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const page = entry.data;

const allEntries = await getCollection('principle');
const sortedPages = allEntries.map(e => e.data).sort((a, b) => a.position - b.position);
const idx = sortedPages.findIndex(p => p.slug === page.slug);
const prevPage = idx === 0? null: sortedPages[idx - 1];
const nextPage = idx < sortedPages.length - 1? sortedPages[idx + 1]: null;
const posLabel = `${String(idx + 1).padStart(2, '0')}\u2009/\u2009${String(sortedPages.length).padStart(2, '0')}`;

const normalizePreIndentation = (html) => html.replace(/<pre>([\s\S]*?)<\/pre>/g, (_match, preBody) => {
	const normalizedBody = preBody.replace(/\n( +)(?=\S)/g, (_line, spaces) => {
		const normalizedSize = Math.max(4, spaces.length * 4);
		return `\n${' '.repeat(normalizedSize)}`;
	});
	return `<pre>${normalizedBody}</pre>`;
});

const attachSoCTabBehavior = page.slug === 'soc';
const attachPkgTabBehavior = page.slug === 'pkg';
---

<BaseLayout
	title={`${page.navLabel || page.title} - Principios de diseño de software`}
	description={page.description}
	accent={page.accent}
	widthClass={page.width === 'wide'? 'layout-wide': ''}
	bodyClass={page.slug === 'screaming-architecture'? 'screaming-page': ''}
	image={`og/${page.slug}.jpg`}
	canonicalURL={`${Astro.site}/principios/${page.slug}/`}
	type="article"
	jsonLd={{
		'@context': 'https://schema.org',
		'@graph': [
			{
				'@type': 'TechArticle',
				headline: page.title,
				description: page.description || page.headerSubtitle || '',
				url: `${Astro.site}/principios/${page.slug}/`,
				inLanguage: 'es',
				author: {
					'@type': 'Person',
					name: 'Gustavo Adrián Salvini',
					url: 'https://github.com/guspatagonico',
				},
				about: {
					'@type': 'Thing',
					name: page.navLabel || page.title,
				},
				educationalLevel: 'intermediate',
				learningResourceType: 'Conceptual',
				position: page.position,
			},
			{
				'@type': 'BreadcrumbList',
				itemListElement: [
					{
						'@type': 'ListItem',
						position: 1,
						name: 'Inicio',
				item: `${Astro.site}/`,
				},
				{
					'@type': 'ListItem',
					position: 2,
					name: page.title,
					item: `${Astro.site}/principios/${page.slug}/`,
					},
				],
			},
		],
	}}
>
	<SiteNav
		position="top"
		{prevPage}
		{nextPage}
		{posLabel}
		isFirstPage={idx === 0}
	/>

	<header>
		<div class="header-label">{page.headerLabel || 'Principios de diseño · Referencia para devs'}</div>
		<h1 set:html={page.headerTitle || ''}></h1>
		<p set:html={page.headerSubtitle || ''}></p>
	</header>

	<TabNav tabs={page.tabs} />
	{attachSoCTabBehavior && (
		<script is:inline>
			{`
				(function () {
					const syncSocCards = () => {
						document.querySelectorAll('.arch-card').forEach(card => {
							const isExpanded = card.classList.contains('expanded');
							card.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
						});
					};

					document.addEventListener('click', event => {
						const card = event.target.closest('.arch-card');
						if (!card) return;
						card.classList.toggle('expanded');
						syncSocCards();
					});

					syncSocCards();
				})();
			`}
		</script>
	)}
	{attachPkgTabBehavior && (
		<script is:inline>
			{`
				(function () {
					document.addEventListener('click', event => {
						const card = event.target.closest('.principle-card');
						if (!card) return;
						card.classList.toggle('expanded');
					});
				})();
			`}
		</script>
	)}

	<main>
		{page.tabs.map((tab, i) => {
			const letterColor = tab.tabColorVar? `--letter-color: var(${tab.tabColorVar})`: '';
			const interpolatedContent = tab.tabColorVar? tab.content.replace(/<div class="p-letter">/g, `<div class="p-letter" style="${letterColor}">`): tab.content;
			const normalizedContent = normalizePreIndentation(interpolatedContent);
			return (<div class={`panel${i === 0? ' active': ''}`} id={`panel-${i}`}>
					<Fragment set:html={normalizedContent} />
				</div>);
		})}

		<ContextSection origin={page.origin} scope={page.scope} />

		<ProgressNav tabCount={page.tabs.length} />
	</main>

	<footer>
		<span set:html={page.footerLeft || ''}></span>
		<span set:html={page.footerRight || '<a href="https://gustavosalvini.com.ar" target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer">Gustavo Adrián Salvini</a> · <a href="https://x.com/guspatagonico" target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer">@guspatagonico</a>'}></span>
	</footer>

	<SiteNav
		position="bot"
		{prevPage}
		{nextPage}
		{posLabel}
		isFirstPage={idx === 0}
	/>
</BaseLayout>
